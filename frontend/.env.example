# FoodBridge Frontend Environment Configuration

# In Development: Leave blank to use Vite dev server proxy (/api -> http://localhost:5000),
# or explicitly set to http://localhost:5000/api
VITE_API_BASE_URL=

# In Production (Vercel Environment Variables):
# Set to your hosted production backend REST API URL:
# Example: https://foodbridge-backend.onrender.com/api
# Example: https://foodbridge-api.up.railway.app/api
