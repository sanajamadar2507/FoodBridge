# FoodBridge Backend Environment Configuration

# Server Port
PORT=5000

# Environment Mode (development | production | test)
NODE_ENV=development

# Database Connection URL
# Local SQLite default:
DATABASE_URL="file:./dev.db"
# Production PostgreSQL example (Neon / Supabase / Railway):
# DATABASE_URL="postgresql://user:password@host:5432/foodbridge?sslmode=require"

# JWT Secret Key for signing and verifying authentication tokens
JWT_SECRET="foodbridge_jwt_secret_key_2026_super_secure_39105820158"

# Allowed CORS Origins (comma-separated frontend URLs, or * for unrestricted)
ALLOWED_ORIGINS="http://localhost:3000,https://your-foodbridge-frontend.vercel.app"
